# ===== Supabase (database + auth) =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Backend =====
PORT=5000

# ===== AI analysis (Stage 5) =====
# Optional. Without a key, CivicFlow uses its deterministic heuristic analyzer.
# xAI API usage is billed by tokens; only use this if your xAI account has
# available credits/budget. Get a key from https://console.x.ai/
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.3

# ===== Weather collector (Stage 6) =====
WEATHER_API_KEY=
# Coordinates the weather collector watches (required for weather runs)
WEATHER_LAT=
WEATHER_LNG=
# Optional OpenWeather One Call endpoint override
WEATHER_ONECALL_URL=

# ===== OpenStreetMap collector (Stage 6) =====
# Bounding box "minLat,minLng,maxLat,maxLng" (default: Dehradun area)
OSM_BBOX=30.25,77.95,30.40,78.15
OSM_OVERPASS_URL=

# ===== Collector schedules (cron expressions; empty disables a job) =====
COLLECTOR_WEATHER_SCHEDULE=0 */3 * * *
COLLECTOR_OSM_SCHEDULE=0 */6 * * *
MATCHING_SWEEP_SCHEDULE=*/30 * * * *
MATCHING_SWEEP_ENABLED=true

# ===== Frontend (frontend/.env.local) — anon key ONLY, never the service key =====
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
# VITE_API_URL=http://localhost:5000

# Note: the variables above are the backend's copy; frontend-specific ones are
# prefixed with VITE_ and read by Vite at build time.
