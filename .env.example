# ===== Supabase (database + auth) =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Backend =====
PORT=5000

# ===== AI analysis (Stage 5). Optional: without a key a deterministic
# heuristic analyzer is used instead. Any OpenAI-compatible endpoint works. =====
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== Weather collector (Stage 6) =====
WEATHER_API_KEY=
# Coordinates the weather collector watches (required for weather runs)
WEATHER_LAT=
WEATHER_LNG=
# Optional OpenWeather One Call endpoint override
WEATHER_ONECALL_URL=

# ===== OpenStreetMap collector (Stage 6) =====
# Bounding box "minLat,minLng,maxLat,maxLng" (default: Bengaluru area)
OSM_BBOX=12.90,77.50,13.10,77.70
OSM_OVERPASS_URL=

# ===== Collector schedules (cron expressions; empty disables a job) =====
COLLECTOR_WEATHER_SCHEDULE=0 */3 * * *
COLLECTOR_OSM_SCHEDULE=0 */6 * * *
MATCHING_SWEEP_SCHEDULE=*/30 * * * *
MATCHING_SWEEP_ENABLED=true

# Note: frontend-specific variables (e.g. VITE_SUPABASE_URL) will be added
# under frontend/ when the Supabase integration is wired up.
